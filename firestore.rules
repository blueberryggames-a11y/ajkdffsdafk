rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Maintenance mode — public read for everything by default
    match /{document=**} {
      allow read: if true;
    }

    // Admin settings — read only
    match /admin/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Comments — nested per anime/episode:
    //   comments/{animeId}/episodes/{episodeNumber}/messages/{commentId}
    match /comments/{animeId}/episodes/{episodeNumber}/messages/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() < 2000;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly(['replies']);

      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Flat "recent comments" feed used by the home page widget
    match /comments_recent/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() < 2000;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // User profiles — anyone can read (so profile pages/avatars are public),
    // only the owner can write their own doc.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Site-wide config (announcement banner + maintenance mode toggle).
    // Only the admin account may write; the client only *shows* the /admin
    // UI to that email, this is what actually enforces it.
    match /site_config/{document} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'coltenboop@gmail.com';
    }

    // Hourly visit counters powering the admin activity graph. No personal
    // data — just an incrementing count per hour bucket — so any visitor
    // (including signed-out ones) can bump it.
    match /stats_hourly/{bucketId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
